# The backend is available to devices on the local network by default.
# Use only on a trusted network. Never expose port 3000 to the public internet.
PORT=3000
RELAY_HOST=0.0.0.0

# Optional path to the local Codex binary. If omitted, `codex` must be on PATH.
# CODEX_BIN=codex
# CODEX_HOME=/Users/you/.codex
# Select the project from the Relay UI after starting the app.

# A token is generated at ~/.relay-web/auth-token when listening beyond loopback.
# You can set RELAY_AUTH_TOKEN to override it. Keep the token private.
# RELAY_AUTH_TOKEN=replace-with-a-long-random-secret
