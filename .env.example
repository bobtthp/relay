# The backend listens only on loopback by default. Do not expose it publicly
# without setting a strong authentication token and HTTPS reverse proxy.
PORT=3000
RELAY_HOST=127.0.0.1

# Optional path to the local Codex binary. If omitted, `codex` must be on PATH.
# CODEX_BIN=codex
# CODEX_HOME=/Users/you/.codex
# Select the project from the Relay UI after starting the app.

# Required when RELAY_HOST is not localhost. Send as Bearer token or x-relay-token.
# RELAY_AUTH_TOKEN=replace-with-a-long-random-secret
