{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../../dist-server",
    "rootDir": "../..",
    "noEmit": false
  },
  "include": ["src/**/*.ts", "../../packages/protocol/src/**/*.ts"]
}
